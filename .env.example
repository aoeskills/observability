# Copy to .env and fill in. .env is gitignored (chmod 600). Shared by local and prod mode; storage settings do NOT go
# here (.local.env / .prod.env), because a value in .env would override them.

# OpenObserve root account (login for <host>/openobserve/ and the ingest credential used by the collector).
ZO_ROOT_USER_EMAIL=root@example.com
# 8-128 chars with lower, upper, digit and special character (OpenObserve refuses to start otherwise)
ZO_ROOT_USER_PASSWORD=change-me
O2_ORG=default
# Seconds between provisioner passes (Grafana dashboards / alert rules, OpenObserve dashboards per stream)
DASHBOARD_SYNC_INTERVAL=60
# Days of data OpenObserve keeps (it deletes expired files from the bucket itself)
O2_RETENTION_DAYS=30

# Grafana (<host>/grafana/): machines + services dashboards and LINE alerts
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Alerts (Grafana -> LINE Messaging API push). Secrets, never commit. After a change recreate Grafana
# (a restart does not re-read env):  docker compose -f docker-compose.local.yml up -d grafana
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Observer host only: where the gateway (otel-collector :4317) listens for agents. Default 127.0.0.1 (this machine's
# agent only); 0.0.0.0 = any IP, the client certificate (mTLS) is the key. Recreate otel-collector after a change.
# OTEL_GATEWAY_BIND=0.0.0.0

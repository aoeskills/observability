# Storage settings for prod mode (docker-compose.prod.yml). Copy to .prod.env (gitignored, chmod 600) and fill in.
# Local mode uses .local.env instead.

# Bucket through the S3 API (required): endpoint, region, bucket and an access key / secret key with read-write access.
# The bucket must exist; OpenObserve does not create it. No lifecycle rules (OpenObserve applies retention itself).
O2_S3_SERVER_URL=
O2_S3_REGION=
O2_S3_ACCESS_KEY=
O2_S3_SECRET_KEY=
O2_S3_BUCKET=
# Optional sub-directory, so several stacks can share one test bucket
O2_S3_PREFIX=
# Random secret, set once per OpenObserve metadata DB and never changed: openssl rand -hex 24
O2_EXT_AUTH_SALT=

# One Postgres server holding three databases: openobserve, grafana, monitoring.
# db-init creates them if the user may (CREATEDB); otherwise create them by hand. The password must be URL-safe.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require

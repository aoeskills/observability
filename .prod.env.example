# Storage settings for prod mode (docker-compose.prod.yml). Copy to .prod.env (gitignored, chmod 600) and fill in.
# Local mode uses .local.env instead.

# Bucket through the S3 API. GCS: create an HMAC key for a service account with access to the bucket.
O2_S3_SERVER_URL=https://storage.googleapis.com
# GCS: the bucket's location, e.g. asia-east1
O2_S3_REGION=
O2_S3_ACCESS_KEY=
O2_S3_SECRET_KEY=
O2_S3_BUCKET=
# Optional sub-directory, so several stacks can share one test bucket
O2_S3_PREFIX=
# Random secret, set once per OpenObserve metadata DB and never changed: openssl rand -hex 24
O2_EXT_AUTH_SALT=

# One Postgres server (e.g. Cloud SQL) holding three databases: openobserve, grafana, monitoring.
# db-init creates them if the user may (CREATEDB); otherwise create them by hand. The password must be URL-safe.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require

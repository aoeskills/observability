# Storage settings for local mode (docker-compose.local.yml), matching its bucket (RustFS) and Postgres containers.
# Dev-only credentials: neither container is reachable from outside this machine. Prod takes the same variables from .prod.env.
O2_S3_SERVER_URL=http://bucket:9000
O2_S3_REGION=us-east-1
O2_S3_ACCESS_KEY=local-dev
O2_S3_SECRET_KEY=local-dev-secret
O2_S3_BUCKET=openobserve
O2_S3_PREFIX=
O2_EXT_AUTH_SALT=local-dev-salt-0123456789abcdef

PG_HOST=postgres
PG_PORT=5432
PG_USER=observability
PG_PASSWORD=local-dev
PG_SSLMODE=disable
